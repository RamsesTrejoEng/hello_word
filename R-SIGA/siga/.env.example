# Copia este archivo como ".env" y ajusta los valores:  cp .env.example .env
# NUNCA subas tu .env a GitHub.

# Base de datos. Déjalo comentado para usar SQLite (archivo siga.db, ideal para empezar).
# Para PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://siga:TU_CLAVE@localhost:5432/siga

# Llave para firmar sesiones. Genera una con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=pega-aqui-la-llave-generada

# Minutos que dura una sesión
TOKEN_MINUTOS=120
